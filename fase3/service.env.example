# Copie para fase3/service.env e ajuste uma vez para a sua infraestrutura.
FASE3_GIT_REMOTE=origin
FASE3_GIT_BRANCH=main
FASE3_HOST=127.0.0.1
FASE3_PORT=8010
FASE3_ALLOWED_ORIGINS=https://assistente-protocolos-fase3.pages.dev
FASE3_ALLOW_REMOTE_TRAINING=0
FASE3_INSTANCE_NAME="Backend local"

# Em ambientes sem .venv-fase3, informe o Python que possui as dependencias.
# FASE3_PYTHON=/caminho/para/python
