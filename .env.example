# Copie para `.env` na raiz do projeto e preencha. O `.env` fica fora do git.
# A fase4 le este arquivo sozinha (fase4/config.py); variaveis ja definidas
# no ambiente tem prioridade.

# Azure AI Speech (Speech to Text). Use a chave 1 ou 2 e a regiao/localizacao
# do recurso (ex.: brazilsouth, eastus). O SDK monta o endpoint pela regiao.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Azure AI Language (Text Analytics). Use a chave 1 ou 2 e o endpoint completo
# do recurso, com https:// e a barra final.
AZURE_LANGUAGE_KEY=
AZURE_LANGUAGE_ENDPOINT=https://<recurso>.cognitiveservices.azure.com/

# Opcionais da fase4
# FASE4_WHISPER_MODELO=small
# FASE4_WEBHOOK_URL=http://127.0.0.1:8765/alertas
